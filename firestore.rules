rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and ownership
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCircleMember(circleData) {
      return isAuthenticated() && (request.auth.uid in circleData.memberUids);
    }

    // A pre-claim dyad pseudo-account (`dyad_{inviteCode}`) created by
    // createDyadInvite before the caregiver has signed up. Its only content
    // is what the issuing doctor entered, gated behind an unguessable invite
    // code (see dyadInvites below — a direct get-by-known-code is open to any
    // authenticated user on the same reasoning, but listing/querying the
    // collection is restricted) — so it's safe to let any professional write
    // it and any authenticated user read it by known id, without extending
    // that same bypass to a real, already-claimed caregiver's uid.
    function isDyadPlaceholder(userId) {
      return userId.matches('^dyad_.*');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp;
    }

    // Maximum raw Zarit Burden Interview score for each instrument tier:
    // 22 items x 4 = 88, 12 items x 4 = 48, 4 items x 4 = 16.
    function zbiMaxScore(tier) {
      return tier == 'ZBI22' ? 88 : (tier == 'ZBI12' ? 48 : 16);
    }

    // Clinician dashboard: a user account is professional/clinical-verified,
    // and has been actively granted access to this specific patient's dyad.
    function isProfessional(uid) {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.role in ['professional', 'doctor', 'nurse'];
    }

    function hasActiveGrant(userId) {
      return isAuthenticated()
          && isProfessional(request.auth.uid)
          && (
            userId.matches('^demo-.*')
            || (
              exists(/databases/$(database)/documents/users/$(userId)/clinicianGrants/$(request.auth.uid))
              && (
                !('revokedAt' in get(/databases/$(database)/documents/users/$(userId)/clinicianGrants/$(request.auth.uid)).data)
                || get(/databases/$(database)/documents/users/$(userId)/clinicianGrants/$(request.auth.uid)).data.revokedAt == null
              )
            )
          );
    }

    // 1. User Profiles & Role Mapping
    match /users/{userId} {
      allow read: if isOwner(userId) || hasActiveGrant(userId);
      allow create: if (isOwner(userId) || (isAuthenticated() && isProfessional(request.auth.uid)))
                    && request.resource.data.role in ['caregiver', 'professional', 'doctor', 'nurse']
                    && request.resource.data.keys().hasAll(['role', 'createdAt'])
                    && request.resource.data.createdAt is timestamp;
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'userId']))
                    && (request.resource.data.role in ['caregiver', 'professional', 'doctor', 'nurse']);
      allow delete: if isOwner(userId);

      // Subcollection: Care Recipients (Elderly profiles under caregiver management)
      match /careRecipients/{recipientId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Vital Logs (Blood Pressure, Blood Glucose, Pulse, Weight, Sleep)
      // Read/write opened to a granted clinician, matching functionScores and
      // patientProfile below — a doctor or shift nurse may log a reading
      // during a visit, and a doctor needs to review the trend during an OPD
      // consult. Previously owner-only, which meant a clinician's dashboard
      // could never legitimately show a roster patient's vitals at all.
      //
      // AUDIT TRAIL — create-only:
      // Vital readings are immutable clinical observations. Correcting an
      // entry means a new record, not mutating history.
      match /vitals/{vitalId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create: if (isOwner(userId) || hasActiveGrant(userId))
                      && request.resource.data.keys().hasAll(['date', 'sleep', 'createdAt'])
                      && request.resource.data.sleep in ['good', 'average', 'poor']
                      && request.resource.data.createdAt is string;
        // No allow update or allow delete — vitals is append-only.
      }

      // Subcollection: Daily bedside care sheets maintained by a nurse,
      // medical assistant, caregiver, or granted clinician. Unlike vitals,
      // a date/shift sheet is intentionally mutable during the active day.
      match /dailyCareLogs/{logId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.id == logId
                              && request.resource.data.date is string
                              && request.resource.data.shift in ['morning', 'day', 'evening', 'night', 'full_day']
                              && request.resource.data.recordedByRole in ['nurse', 'medical_assistant', 'caregiver', 'doctor', 'unknown']
                              && request.resource.data.monitoringRows is list
                              && request.resource.data.medications is list
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Document: full medication regimen, synced as one array (there is one
      // active regimen per dyad, edited in place — not append-only readings
      // like vitals/zarit). Single fixed-id document ('current'), same
      // convention as patientProfile. A granted clinician may add/update
      // prescriptions during an OPD encounter, same as functionScores.
      match /medications/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.items is list
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Module Progress (Stores discrete Set of completed section IDs).
      // Read is also opened to a granted clinician so a doctor who assigned
      // modules (see assignedModules below) can see whether the caregiver
      // actually completed them — otherwise the assignment loop never closes.
      match /moduleProgress/{moduleId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.completedSections is list
                              && request.resource.data.completedSections.size() <= 100
                              && request.resource.data.lastAccessedAt is string;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Zarit Caregiver Burden Assessments (ZBI-22, ZBI-12, ZBI-4)
      // Stores only aggregate scores/factors — never raw per-item Likert
      // responses (see calculateZaritScore) — so every document here is
      // already "summary scope" by construction. This is why a clinician
      // grant can safely read the whole document with no field redaction:
      // there is no item-level answer (e.g. "do you feel angry...") to leak.
      // The score ceiling is per-tier: ZBI-22 maxes at 88, ZBI-12 at 48 and
      // ZBI-4 at 16. A flat <= 88 bound let a tier/score mismatch through
      // (e.g. tier 'ZBI4' with totalScore 88), which yields a normalized
      // percentage far above 100 and corrupts every downstream trend slope.
      //
      // AUDIT TRAIL — create-only:
      // Past assessments are immutable clinical records. Correcting a mistake
      // means a new record (with a notes field), not mutating history. Neither
      // the owning caregiver nor a granted clinician may update or delete a
      // zaritAssessment document — this is an audit-trail requirement, not
      // just a data-modeling nicety.
      //
      // normalizedPercentage is `number` (not `int`) to allow float values;
      // the score is computed as (totalScore / maxScore * 100) which yields a
      // float for most real-world inputs (e.g. 47 / 88 * 100 = 53.4090...).
      match /zaritAssessments/{assessmentId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create: if (isOwner(userId) || hasActiveGrant(userId))
                      && request.resource.data.tier in ['ZBI22', 'ZBI12', 'ZBI4']
                      && request.resource.data.totalScore is int
                      && request.resource.data.totalScore >= 0
                      && request.resource.data.totalScore <= zbiMaxScore(request.resource.data.tier)
                      && request.resource.data.normalizedPercentage is number
                      && request.resource.data.normalizedPercentage >= 0
                      && request.resource.data.normalizedPercentage <= 100
                      && request.resource.data.completedAt is string;
        // No allow update or allow delete — zaritAssessments is append-only.
      }

      // Subcollection: Reassessment requests from clinicians
      match /reassessmentRequests/{docId} {
        allow read, write: if isOwner(userId) || hasActiveGrant(userId);
      }

      // Subcollection: Reassessment alerts for clinicians. `userId` here is
      // the CLINICIAN's own uid (alerts live under the recipient, not the
      // patient) — the caregiver whose burden score triggered the alert is
      // never `isOwner(userId)`, so a narrower bypass is needed. Scoped to
      // exactly that caregiver (their own uid must equal the alert's
      // patientUid field) acting on a clinician they actually have an active
      // grant with — not "any authenticated user", which would let a
      // stranger spam alerts into any clinician's inbox.
      match /reassessmentAlerts/{alertId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated()
                      && request.resource.data.patientUid == request.auth.uid
                      && exists(/databases/$(database)/documents/users/$(request.auth.uid)/clinicianGrants/$(userId))
                      && (
                        !('revokedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)/clinicianGrants/$(userId)).data)
                        || get(/databases/$(database)/documents/users/$(request.auth.uid)/clinicianGrants/$(userId)).data.revokedAt == null
                      );
      }

      // Subcollection: Appointments
      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId) || hasActiveGrant(userId);
      }

      // Subcollection: Care-recipient functional status (Barthel ADL / Lawton
      // IADL). Higher barthelScore = more independent. Either the owning
      // caregiver or a currently-granted clinician may record a reading —
      // clinicians typically administer this during an OPD encounter.
      //
      // AUDIT TRAIL — create-only:
      // Function scores are immutable clinical observations. Correcting a
      // score means recording a new one, not overwriting the previous.
      match /functionScores/{scoreId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create: if (isOwner(userId) || hasActiveGrant(userId))
                      && request.resource.data.barthelScore is int
                      && request.resource.data.barthelScore >= 0
                      && request.resource.data.barthelScore <= 100
                      && request.resource.data.lawtonScore is int
                      && request.resource.data.lawtonScore >= 0
                      && request.resource.data.lawtonScore <= 8
                      && request.resource.data.recordedAt is string;
        // No allow update or allow delete — functionScores is append-only.
      }

      // Subcollection: Patient dependence profile (Katz ADL / Lawton IADL /
      // cognitive-behavioral load), synced from the caregiver's local
      // CareGapEngine intake. Single fixed-id document ('current') — there is
      // exactly one patient per caregiver's dyad in this data model, same as
      // functionScores below. A granted clinician may also write this during
      // an OPD visit. Any professional may additionally write (and any
      // authenticated user may read) a `dyad_*` placeholder specifically —
      // that's the doctor-pre-registration bootstrap case (createDyadInvite),
      // before a clinicianGrant exists yet. A REAL claimed caregiver's uid
      // must go through hasActiveGrant like every other clinical collection
      // — an unscoped `isProfessional` bypass here previously let ANY
      // verified doctor/nurse overwrite ANY dyad's ADL profile, granted or not.
      match /patientProfile/{profileId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId) || (isAuthenticated() && isProfessional(request.auth.uid) && isDyadPlaceholder(userId)))
                              && request.resource.data.katzAdl is map
                              && request.resource.data.lawtonIadl is map
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Document: Caregiver capacity, family support network, and formal
      // support infrastructure (e.g. attendant 10h/day, secondary family
      // members). Same dyad-placeholder-only professional bypass as
      // patientProfile above — see that comment for the access-control
      // rationale.
      match /caregiverAttributes/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId) || (isAuthenticated() && isProfessional(request.auth.uid) && isDyadPlaceholder(userId)))
                              && request.resource.data.name is string;
        allow delete: if isOwner(userId);
      }

      // Document: learning modules a clinician has explicitly assigned to
      // this patient's caregiver, on top of the automatic comorbidity-based
      // suggestions computed client-side. Single fixed-id document, same
      // convention as patientProfile/medications. Clinician-write only —
      // assignment is a clinical judgment call, not something a caregiver
      // sets for themselves (they still see and complete the modules; see
      // the /modules page's "Assigned by your doctor" section).
      match /assignedModules/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId) || isDyadPlaceholder(userId);
        allow create, update: if hasActiveGrant(userId)
                              && request.resource.data.moduleIds is list
                              && request.resource.data.assignedByUid == request.auth.uid
                              && request.resource.data.assignedAt is string;
        allow delete: if isOwner(userId) || hasActiveGrant(userId);
      }

      // Document: the caregiver's Care Circle — helper family members/friends
      // and the coordination tasks assigned among them. Single fixed-id
      // document ('current'), same convention as caregiverAttributes/
      // medications. Previously local-storage-only with no Firestore mirror
      // at all, so a home nurse or family member's task assignments were
      // invisible to the doctor and to any other device.
      match /careCircle/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.members is list
                              && request.resource.data.tasks is list
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Bedside nursing procedure checklists (one document per
      // calendar date), maintained by a shift nurse or granted clinician.
      // Mutable during the active day, same convention as dailyCareLogs.
      match /nursingProcedures/{dateId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.date is string
                              && request.resource.data.procedures is map
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Document: emergency contact list. Read opened to a granted clinician
      // (useful during an actual crisis call), write stays owner-only — this
      // is the caregiver's own family/contact management, not something a
      // clinician edits on their behalf. Previously local-storage-only with
      // no Firestore mirror at all.
      match /emergencyContacts/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if isOwner(userId)
                              && request.resource.data.contacts is list
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Document: DPDP Act 2023 consent record. Owner-only in both
      // directions — this is a legal consent artifact tied to the account
      // holder, not a clinical record a clinician needs to read or edit.
      match /consent/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: in-progress form drafts (e.g. a partially-filled
      // vitals entry, the multi-step onboarding wizard) — autosaved so nothing
      // is lost if the tab closes mid-entry. Owner-only: this is unsaved,
      // unsubmitted input, not a clinical record a clinician needs to see.
      // One document per draft kind (docId is a fixed label like
      // 'vitalsDraft', not a generated id), overwritten in place.
      match /drafts/{draftId} {
        allow read, write: if isOwner(userId);
      }

      // Document: today's bedside routine checklist (sensory hygiene, skin
      // checks, Q2H turns) tracked from the Domiciliary Care tab. Previously
      // local-storage-only, bypassing HealthRepository entirely, with no
      // Firestore mirror — a nurse's completed tasks were invisible to the
      // doctor or the family checking in remotely.
      match /bedsideRoutineChecklist/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.completedTasks is map
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Document: 14-day post-discharge pathway milestone checklist.
      // Previously local-storage-only with no Firestore mirror — a doctor
      // following up post-discharge had no visibility into pathway progress.
      match /dischargeMilestones/{docId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.completedMilestones is map
                              && request.resource.data.updatedAt is string;
        allow delete: if isOwner(userId);
      }

      // Subcollection: OPD encounters. The visit anchor that Zarit/function
      // readings and clinical prescriptions attach to.
      match /encounters/{encounterId} {
        allow read: if isOwner(userId) || hasActiveGrant(userId);
        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))
                              && request.resource.data.visitDate is string
                              && request.resource.data.clinicianUid is string;
        allow delete: if isOwner(userId);
      }

      // Subcollection: Clinician access grants (consent). One document per
      // clinician a caregiver has shared this dyad with. Only the owning
      // caregiver can create, update, or revoke a grant — consent can never
      // be self-issued by the clinician side, and a grant is deleted or
      // revoked (revokedAt set), never silently mutated into wider scope.
      // The grantee may read their own grant document to check its status.
      match /clinicianGrants/{clinicianUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == clinicianUid);
        allow create: if (isOwner(userId) || (isAuthenticated() && isProfessional(request.auth.uid) && request.auth.uid == clinicianUid))
                      && request.resource.data.clinicianUid == clinicianUid
                      && request.resource.data.grantedAt is string
                      && request.resource.data.revokedAt == null;
        allow update: if isOwner(userId)
                      && request.resource.data.clinicianUid == clinicianUid;
        allow delete: if isOwner(userId);
      }
    }

    // 1b. Collection-group read access for clinicianGrants. The nested rule
    // above (inside match /users/{userId}) already covers the caregiver's
    // own direct-path get/list/create/update/delete. This additional
    // `{path=**}` rule exists only for the clinician roster's
    // cross-caregiver `list`: `collectionGroup('clinicianGrants')
    // .where('clinicianUid','==',me)`. A collection-group `list` needs a
    // rule declared at the `{path=**}` level to be authorized at all — the
    // nested rule doesn't extend to it automatically. Keyed off the
    // document's own `clinicianUid` field (not a path-segment variable,
    // which this rules engine does not bind for list requests) — that
    // field is required and immutable-by-caregiver-only per the create/
    // update rules above, so it's a trustworthy match target.
    match /{path=**}/clinicianGrants/{clinicianUid} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.clinicianUid;
    }

    // 1c. Doctor-initiated patient registration invite codes. A doctor cannot
    // create another person's login account from the client SDK, so a doctor
    // "registering a new patient" pre-stages the dyad's basic intake here
    // under a short code; the caregiver claims it on their own first sign-in,
    // which client-side then creates the clinicianGrant under their own uid
    // (already permitted by the isOwner(userId) rule above) — this collection
    // itself only ever stores the pre-claim intake + claim status, never the
    // grant relationship, so read access here cannot itself expose grants.
    match /dyadInvites/{inviteCode} {
      // Direct lookup by a known code (claim flow) — codes are short-lived,
      // unguessable random tokens, so a get-by-known-code is safe for any
      // authenticated user.
      allow get: if isAuthenticated();
      // Listing/querying is restricted to invites the requester has a
      // legitimate reason to see: the clinician who issued them, or the
      // caregiver whose own Firebase Auth phone number matches the invite's
      // caregiverPhone. Without this split, `allow read` would also cover an
      // unfiltered `list`/query, letting any authenticated user enumerate
      // every clinician's entire patient roster.
      allow list: if isAuthenticated()
                  && (
                    resource.data.clinicianUid == request.auth.uid
                    || (request.auth.token.phone_number != null
                        && resource.data.caregiverPhone == request.auth.token.phone_number)
                  );
      allow create: if isAuthenticated()
                    && isProfessional(request.auth.uid)
                    && request.resource.data.clinicianUid == request.auth.uid
                    && request.resource.data.claimedAt == null
                    && request.resource.data.claimedByUid == null
                    && request.resource.data.patientName is string
                    && request.resource.data.createdAt is string;
      // Two distinct update paths, both only while still unclaimed — an
      // already-claimed invite is immutable from here on:
      //   1. Claim: any authenticated user marks it claimed (only
      //      claimedAt/claimedByUid change).
      //   2. Draft: the issuing clinician attaches/updates a full ADL
      //      assessment (e.g. filled out live in onboarding Step 2 right
      //      after generating the code, before the caregiver has signed up)
      //      — core identity fields stay immutable, only claimedAt/
      //      claimedByUid.
      allow update: if isAuthenticated()
                    && resource.data.claimedAt == null
                    && request.resource.data.clinicianUid == resource.data.clinicianUid
                    && request.resource.data.patientName == resource.data.patientName
                    && (
                      (request.resource.data.claimedByUid == request.auth.uid
                       && request.resource.data.claimedAt is string)
                      ||
                      (request.auth.uid == resource.data.clinicianUid
                       && request.resource.data.claimedAt == null
                       && request.resource.data.claimedByUid == null)
                    );
      allow delete: if isAuthenticated() && resource.data.clinicianUid == request.auth.uid;
    }

    // 2. Care Circles (Multi-caregiver team collaboration)
    match /careCircles/{circleId} {
      allow read: if isCircleMember(resource.data);
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids
                    && request.resource.data.memberUids.size() <= 25;
      allow update: if isAuthenticated()
                    && (resource.data.ownerUid == request.auth.uid || isCircleMember(resource.data))
                    && request.resource.data.memberUids.size() <= 25;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
