# This file is an example. Create a .env.local file and add your own variables.
# This key is required for the AI features to work.
# Get your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase — for local development, leave these as the demo values below and
# run `npm run emulators` in one terminal, `npm run dev` in another. The app
# connects to the emulator suite automatically. For a real deployment, replace
# with your Firebase project's actual web app config and set
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR to "false".
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="sanjeevani-dev.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="sanjeevani-dev"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="sanjeevani-dev.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
NEXT_PUBLIC_USE_FIREBASE_EMULATOR="true"
