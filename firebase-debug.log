[debug] [2026-08-23T11:02:32.995Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/sanjeevani-dev:securityRules [none]
[debug] [2026-08-23T11:02:32.995Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/sanjeevani-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions for authentication and ownership\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isCircleMember(circleData) {\n      return isAuthenticated() && (request.auth.uid in circleData.memberUids);\n    }\n\n    function isValidTimestamp(ts) {\n      return ts is timestamp;\n    }\n\n    // Clinician dashboard: a caregiver's account is professional-verified,\n    // and has been actively (never revoked) granted access to this specific\n    // patient's dyad by the owning caregiver. Both conditions are required —\n    // a grant document alone is not enough if the grantee's own account was\n    // never marked 'professional', and a 'professional' role alone grants\n    // nothing without an explicit per-patient grant from the caregiver.\n    function isProfessional(uid) {\n      return exists(/databases/$(database)/documents/users/$(uid))\n          && get(/databases/$(database)/documents/users/$(uid)).data.role == 'professional';\n    }\n\n    function hasActiveGrant(userId) {\n      return isAuthenticated()\n          && isProfessional(request.auth.uid)\n          && exists(/databases/$(database)/documents/users/$(userId)/clinicianGrants/$(request.auth.uid))\n          && get(/databases/$(database)/documents/users/$(userId)/clinicianGrants/$(request.auth.uid)).data.revokedAt == null;\n    }\n\n    // 1. User Profiles & Role Mapping\n    match /users/{userId} {\n      allow read: if isOwner(userId);\n      allow create: if isOwner(userId)\n                    && request.resource.data.role in ['caregiver', 'professional']\n                    && request.resource.data.keys().hasAll(['role', 'createdAt'])\n                    && request.resource.data.createdAt is timestamp;\n      allow update: if isOwner(userId)\n                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'userId']))\n                    && (request.resource.data.role in ['caregiver', 'professional']);\n      allow delete: if isOwner(userId);\n\n      // Subcollection: Care Recipients (Elderly profiles under caregiver management)\n      match /careRecipients/{recipientId} {\n        allow read, write: if isOwner(userId);\n      }\n\n      // Subcollection: Vital Logs (Blood Pressure, Blood Glucose, Pulse, Weight, Sleep)\n      match /vitals/{vitalId} {\n        allow read: if isOwner(userId);\n        allow create: if isOwner(userId)\n                      && request.resource.data.keys().hasAll(['date', 'sleep', 'createdAt'])\n                      && request.resource.data.sleep in ['good', 'average', 'poor']\n                      && request.resource.data.createdAt is timestamp;\n        allow update: if isOwner(userId)\n                      && request.resource.data.sleep in ['good', 'average', 'poor'];\n        allow delete: if isOwner(userId);\n      }\n\n      // Subcollection: Appointments & Tele-consultations\n      match /appointments/{appointmentId} {\n        allow read, write: if isOwner(userId);\n      }\n\n      // Subcollection: Module Progress (Stores discrete Set of completed section IDs)\n      match /moduleProgress/{moduleId} {\n        allow read: if isOwner(userId);\n        allow create, update: if isOwner(userId)\n                              && request.resource.data.completedSections is list\n                              && request.resource.data.completedSections.size() <= 100\n                              && request.resource.data.lastAccessedAt is string;\n        allow delete: if isOwner(userId);\n      }\n\n      // Subcollection: Zarit Caregiver Burden Assessments (ZBI-22, ZBI-12, ZBI-4)\n      // Stores only aggregate scores/factors — never raw per-item Likert\n      // responses (see calculateZaritScore) — so every document here is\n      // already \"summary scope\" by construction. This is why a clinician\n      // grant can safely read the whole document with no field redaction:\n      // there is no item-level answer (e.g. \"do you feel angry...\") to leak.\n      match /zaritAssessments/{assessmentId} {\n        allow read: if isOwner(userId) || hasActiveGrant(userId);\n        allow create: if isOwner(userId)\n                      && request.resource.data.tier in ['ZBI22', 'ZBI12', 'ZBI4']\n                      && request.resource.data.totalScore is int\n                      && request.resource.data.totalScore >= 0\n                      && request.resource.data.totalScore <= 88\n                      && request.resource.data.completedAt is string;\n        allow update, delete: if isOwner(userId);\n      }\n\n      // Subcollection: Care-recipient functional status (Barthel ADL / Lawton\n      // IADL). Higher barthelScore = more independent. Either the owning\n      // caregiver or a currently-granted clinician may record a reading —\n      // clinicians typically administer this during an OPD encounter.\n      match /functionScores/{scoreId} {\n        allow read: if isOwner(userId) || hasActiveGrant(userId);\n        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))\n                              && request.resource.data.barthelScore is int\n                              && request.resource.data.barthelScore >= 0\n                              && request.resource.data.barthelScore <= 100\n                              && request.resource.data.lawtonScore is int\n                              && request.resource.data.lawtonScore >= 0\n                              && request.resource.data.lawtonScore <= 8\n                              && request.resource.data.recordedAt is string;\n        allow delete: if isOwner(userId);\n      }\n\n      // Subcollection: OPD encounters. The visit anchor that Zarit/function\n      // readings and clinical prescriptions attach to.\n      match /encounters/{encounterId} {\n        allow read: if isOwner(userId) || hasActiveGrant(userId);\n        allow create, update: if (isOwner(userId) || hasActiveGrant(userId))\n                              && request.resource.data.visitDate is string\n                              && request.resource.data.clinicianUid is string;\n        allow delete: if isOwner(userId);\n      }\n\n      // Subcollection: Clinician access grants (consent). One document per\n      // clinician a caregiver has shared this dyad with. Only the owning\n      // caregiver can create, update, or revoke a grant — consent can never\n      // be self-issued by the clinician side, and a grant is deleted or\n      // revoked (revokedAt set), never silently mutated into wider scope.\n      // The grantee may read their own grant document to check its status.\n      match /clinicianGrants/{clinicianUid} {\n        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == clinicianUid);\n        allow create: if isOwner(userId)\n                      && request.resource.data.clinicianUid == clinicianUid\n                      && request.resource.data.grantedAt is string\n                      && request.resource.data.revokedAt == null;\n        allow update: if isOwner(userId)\n                      && request.resource.data.clinicianUid == clinicianUid;\n        allow delete: if isOwner(userId);\n      }\n    }\n\n    // 1b. Collection-group read access for clinicianGrants. The nested rule\n    // above (inside match /users/{userId}) governs direct-path get/create/\n    // update/delete. A `list` (query) request against the *collection\n    // group* — e.g. the clinician roster's\n    // `collectionGroup('clinicianGrants').where('clinicianUid','==',me)` —\n    // additionally needs a rule declared with the `{path=**}` wildcard;\n    // Firestore does not extend the nested rule to group-query `list`\n    // requests on its own. `path[1]` recovers the caregiver's userId from\n    // the captured `users/{userId}/clinicianGrants/{clinicianUid}` prefix.\n    match /{path=**}/clinicianGrants/{clinicianUid} {\n      allow read: if isOwner(path[1]) || (isAuthenticated() && request.auth.uid == clinicianUid);\n    }\n\n    // 2. Care Circles (Multi-caregiver team collaboration)\n    match /careCircles/{circleId} {\n      allow read: if isCircleMember(resource.data);\n      allow create: if isAuthenticated()\n                    && request.resource.data.ownerUid == request.auth.uid\n                    && request.auth.uid in request.resource.data.memberUids\n                    && request.resource.data.memberUids.size() <= 25;\n      allow update: if isAuthenticated()\n                    && (resource.data.ownerUid == request.auth.uid || isCircleMember(resource.data))\n                    && request.resource.data.memberUids.size() <= 25;\n      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;\n    }\n  }\n}\n"}]}}
